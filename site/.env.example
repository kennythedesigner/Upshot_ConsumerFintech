# Supabase, for the marketing signup form only (D52a).
#
# Both values are public by design: they ship in the browser bundle. What
# protects the signup list is the database — public.email_signup grants the
# anon role nothing and has RLS on with no policies, so this key can only call
# subscribe_email(), which writes and never reads.
#
# NEVER put a service-role key here. It bypasses RLS.
#
# Set these in Vercel: Project Settings -> Environment Variables.
# Without them the form stays visible but says sign-ups aren't switched on.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
