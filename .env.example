# Upshot — client configuration (SAFE values only)
#
# Copy this file to `.env` and fill in the two values below. `.env` is
# git-ignored, so it never gets committed. This repo is public, so even these
# two "safe" values are kept out of it.
#
# These are the ONLY two values the Framer code component needs. Both are
# meant to be public: the publishable key is designed to be shipped to the
# browser, and Supabase's row-level security is what actually guards the data
# (see supabase/migrations). See SECURITY.md for why.

# Your Supabase project URL.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Your Supabase PUBLISHABLE key (starts with sb_publishable_...).
# Safe to ship to the browser. NOT the service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# NEVER put these in this file, in .env, in the Framer component, or anywhere
# in frontend code. They are real secrets and belong only in the Supabase
# dashboard:
#   - The Supabase SERVICE-ROLE key  (bypasses every security rule)
#   - The Cloudflare Turnstile SECRET key  (CAPTCHA; the site key is the public half)
# ─────────────────────────────────────────────────────────────────────────
